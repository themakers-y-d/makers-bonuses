# משתני הסביבה של המערכת. כולם נדרשים חוץ מ-IG_ACCESS_TOKEN.
# בוורסל: Settings, Environment Variables, סביבת Production.
# בשורת פקודה: vercel env add NAME production --value "..." --yes
# שים לב: להעביר ערכים תמיד עם --value. צינור stdin נבלע בשקט במצב לא אינטראקטיבי.

# הסוד של אפליקציית Meta. משמש לאימות חתימת ה-webhook.
# איפה: developers.facebook.com, האפליקציה שלך, Settings, Basic, App secret, Show.
META_APP_SECRET=

# מחרוזת אקראית שאתה ממציא. מטא מחזירה אותה בלחיצת היד של רישום ה-webhook.
# ליצירה: openssl rand -hex 24
IG_VERIFY_TOKEN=

# מחרוזת אקראית שנייה, שומרת על נקודת הקצה של הסורק מפני קריאות זרות.
# ליצירה: openssl rand -hex 24
IG_POLL_SECRET=

# מזהה המשתמש של חשבון האינסטגרם שלך, בפורמט 17841...
# איפה: בשורת החשבון בסעיף Generate access tokens, ליד שם המשתמש.
# חובה: בלעדיו המערכת עלולה לענות לתגובות של עצמה ולהיכנס ללולאה.
IG_SELF_USER_ID=

# כתובת פרויקט הסופאבייס, בפורמט https://<PROJECT_REF>.supabase.co
SUPABASE_URL=

# מפתח service_role של הסופאבייס. סוד מלא, לעולם לא בצד הלקוח.
# איפה: Supabase, Project Settings, API keys.
SUPABASE_SERVICE_ROLE_KEY=

# אופציונלי. טוקן התחלתי לפני שהשורה נכתבת בטבלת ig_tokens.
# מקור האמת השוטף הוא הטבלה, לא כאן, כי טוקן ב-env דורש פריסה מחדש בכל רענון.
IG_ACCESS_TOKEN=
